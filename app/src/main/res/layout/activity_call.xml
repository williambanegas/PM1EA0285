<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@drawable/imagen_principal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:background="#EAEAEAEE">

        <androidx.cardview.widget.CardView
            android:layout_width="140dp"
            android:layout_height="140dp"
            app:cardCornerRadius="70dp"
            app:cardElevation="6dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/ivCallPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/imagen_default"
                android:contentDescription="Foto del contacto" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvCallName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del Contacto"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvCallPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+504 99999999"
            android:textSize="20sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="36dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnConfirmCall"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Llamar Ahora"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnCancelCall"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Regresar"
            android:textSize="16sp"
            style="?attr/materialButtonOutlinedStyle" />

    </LinearLayout>

</LinearLayout>
