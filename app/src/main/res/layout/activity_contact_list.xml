<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/imagen_principal">

    <!-- Container card for high legibility over background image -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#EAEAEAEE">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnBackToRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Registrar"
                style="?attr/materialButtonOutlinedStyle" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lista de Contactos"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:gravity="center" />
        </LinearLayout>

        <!-- Search input -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Buscar por nombre o número..."
            android:inputType="text"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:background="@color/white"
            android:textSize="16sp" />

        <!-- RecyclerView for contacts -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewContacts"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="16dp" />

        <!-- Bottom Action Buttons Panel (Organized in 2 rows, larger size) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <!-- Row 1: Llamar, Compartir, Ver Foto -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnListCall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Llamar"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnListShare"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Compartir"
                    android:textSize="14sp"
                    android:layout_marginEnd="4dp"
                    style="?attr/materialButtonOutlinedStyle" />

                <Button
                    android:id="@+id/btnListPhoto"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Ver Foto"
                    android:textSize="14sp"
                    style="?attr/materialButtonOutlinedStyle" />
            </LinearLayout>

            <!-- Row 2: Modificar, Eliminar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnListEdit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Modificar"
                    android:textSize="14sp"
                    android:layout_marginEnd="4dp"
                    style="?attr/materialButtonOutlinedStyle" />

                <Button
                    android:id="@+id/btnListDelete"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Eliminar"
                    android:textSize="14sp"
                    android:textColor="@android:color/holo_red_dark"
                    style="?attr/materialButtonOutlinedStyle" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
